{
  "version": 6,
  "configurePresets": [
    {
      "name": "clang-release",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-aarch64",
      "binaryDir": "${sourceDir}/build/clang-aarch64",
      "toolchainFile": "${sourceDir}/cmake/aarch64-linux.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
